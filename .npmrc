# Tuned for an unreliable connection: the default 2 retries and 3 concurrent
# sockets were producing ECONNRESET part-way through installs, leaving
# node_modules half-populated.
#
# Fewer parallel sockets is counter-intuitive but helps here — the resets came
# from saturating the link, not from server-side limits.
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=900000
maxsockets=3

# Noise we never act on during automated installs.
audit=false
fund=false
