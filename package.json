    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "verify": "npm run typecheck && npm run lint && npm run lint:colors && npm run audit:contrast && npm run test",
    "db:check": "node scripts/db-healthcheck.mts"
  },
  "dependencies": {
