// Ash — schema
//
// Phase 1: identity and multi-tenancy. Projects, tasks, comments, goals and
// time tracking arrive in Phases 2–5.
//
// Connection config lives in ../prisma.config.ts (Prisma 7 removed `url` and
// `directUrl` from the schema). Migrations use DIRECT_URL (:5432, session
// mode); the runtime client uses DATABASE_URL (:6543, pooled) via the pg
// driver adapter in lib/db/prisma.ts.
//
// AUTHORIZATION: this client connects with the database credential and so
// bypasses RLS. RLS is enabled deny-all on every table purely as leak
// insurance for the publishable key. Real authorization lives in
// lib/auth/action.ts — nothing may query the database around it.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Application-side user record.
///
/// `id` mirrors `auth.users.id`, which Supabase owns. Prisma does not manage
/// the `auth` schema, so there is no FK here — the link is enforced by a
/// Postgres trigger on `auth.users` that inserts the matching row (see the
/// migration). That means a Profile always exists by the time any app code
/// runs, so callers never have to handle a missing profile.
model Profile {
  id        String  @id @db.Uuid
  email     String  @unique
  fullName  String? @map("full_name")
  avatarUrl String? @map("avatar_url")

  /// IANA zone, e.g. "Asia/Karachi". All timestamps are stored UTC and
  /// rendered in this zone — getting it wrong makes "Today" and every
  /// due-date dashboard subtly incorrect.
  timezone String @default("UTC")

  /// Used by the workload dashboard (Phase 6) to compute over-allocation.
  weeklyCapacityHours Int @default(40) @map("weekly_capacity_hours")

  /// Per-type email preferences, e.g. { "mention": true, "digest": false }.
  notificationPrefs Json @default("{}") @map("notification_prefs")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  sentInvitations Invitation[]      @relation("InvitationInviter")
  activities      ActivityLog[]
  notifications   Notification[]

  ownedProjects  Project[]       @relation("ProjectOwner")
  projectAccess  ProjectMember[]
  createdTasks   Task[]          @relation("TaskCreator")
  assignedTasks  TaskAssignee[]

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST

  @@map("workspace_role")
}

/// The tenant boundary. Every domain row in later phases hangs off a
/// workspace, directly or transitively.
model Workspace {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  /// URL-safe identifier used in paths, e.g. /w/acme/projects.
  slug    String  @unique
  logoUrl String? @map("logo_url")

  ownerId String  @map("owner_id") @db.Uuid
  owner   Profile @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  /// Workspace-level settings (week start, default view, etc.).
  settings Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete: keeps audit history intact and makes recovery possible.
  archivedAt DateTime? @map("archived_at")

  members     WorkspaceMember[]
  invitations Invitation[]
  activities  ActivityLog[]
  projects    Project[]
  labels      Label[]

  @@index([ownerId])
  @@map("workspaces")
}

/// Membership plus role. The pair is unique, so a profile holds exactly one
/// role per workspace.
model WorkspaceMember {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileId String  @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  role WorkspaceRole @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([workspaceId, profileId])
  // Powers "which workspaces am I in?" on every request.
  @@index([profileId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

/// Pending invitation. Deliberately keyed by email rather than profile, so
/// someone can be invited before they have an account.
model Invitation {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  email String
  role  WorkspaceRole @default(MEMBER)

  /// Random, single-use, and stored HASHED — a leaked database dump must not
  /// yield usable invitation links.
  tokenHash String @unique @map("token_hash")

  invitedById String  @map("invited_by_id") @db.Uuid
  invitedBy   Profile @relation("InvitationInviter", fields: [invitedById], references: [id])

  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  // One live invite per email per workspace; re-inviting replaces the old row.
  @@unique([workspaceId, email])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit and notification
// ---------------------------------------------------------------------------

/// Append-only audit trail, written by the `authedAction` wrapper rather than
/// by individual handlers — so an action cannot silently skip being recorded.
/// Powers every activity feed in the app.
model ActivityLog {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Null for system-initiated actions (cron, webhooks).
  actorId String?  @map("actor_id") @db.Uuid
  actor   Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// e.g. "workspace" | "task" | "member"
  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  /// e.g. "created" | "updated" | "deleted" | "role_changed"
  action     String

  /// Field-level before/after, so feeds can render "changed due date from X
  /// to Y" without re-querying.
  diff Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  // Feeds are always "latest first, scoped to a workspace".
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("activity_log")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  recipientId String  @map("recipient_id") @db.Uuid
  recipient   Profile @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  /// e.g. "mention" | "assigned" | "invitation" | "due_soon"
  type    String
  payload Json   @default("{}")

  readAt    DateTime? @map("read_at")
  /// Set once the digest/immediate email has gone out, so we never send twice.
  emailedAt DateTime? @map("emailed_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Drives the unread badge.
  @@index([recipientId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

/// Health marker written by the keepalive cron, which stops the Supabase free
/// tier pausing after 7 days without database activity.
model SystemHealth {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at")
  note      String?

  @@map("system_health")
}

// ---------------------------------------------------------------------------
// Phase 2 — projects, sections, tasks
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED

  @@map("task_status")
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

model Project {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  /// Short code used in task references, e.g. ASH-42. Uppercase, 2-6 chars.
  key         String
  description String?
  /// Token name from the design system palette, never a raw colour.
  color       String  @default("accent")
  /// Lucide icon name.
  icon        String  @default("folder-kanban")

  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date") @db.Date
  targetDate  DateTime?     @map("target_date") @db.Date

  ownerId String  @map("owner_id") @db.Uuid
  owner   Profile @relation("ProjectOwner", fields: [ownerId], references: [id])

  /// When true, only ProjectMember rows may see it — workspace membership is
  /// not enough. Enforced in the query layer, not by RLS.
  isPrivate Boolean @default(false) @map("is_private")

  /// Monotonic counter behind task numbering. Incremented inside the same
  /// transaction that creates a task, so numbers never collide or repeat.
  taskCounter Int @default(0) @map("task_counter")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  members  ProjectMember[]
  sections Section[]
  tasks    Task[]

  // Task keys are unique per workspace, not globally.
  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@index([ownerId])
  @@map("projects")
}

/// Per-project access, only consulted when `Project.isPrivate`.
model ProjectMember {
  id String @id @default(uuid()) @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  profileId String  @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now()) @map("added_at")

  @@unique([projectId, profileId])
  @@index([profileId])
  @@map("project_members")
}

/// An ordered group within a project. Doubles as the default board column.
model Section {
  id String @id @default(uuid()) @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name String
  /// Fractional index, so reordering touches one row (see lib/rank).
  rank String
  /// Soft warning threshold on the board; null means no limit.
  wipLimit Int? @map("wip_limit")

  createdAt DateTime @default(now()) @map("created_at")

  tasks Task[]

  @@unique([projectId, rank])
  @@index([projectId])
  @@map("sections")
}

model Task {
  id String @id @default(uuid()) @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sectionId String?  @map("section_id") @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  /// Human-facing reference number, unique within the project (ASH-42).
  number Int

  /// Subtasks. Restrict rather than Cascade: silently deleting a subtree with
  /// its parent loses work, so the caller must handle children explicitly.
  parentTaskId String? @map("parent_task_id") @db.Uuid
  parentTask   Task?   @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Restrict)
  subtasks     Task[]  @relation("Subtasks")

  title String
  /// Tiptap document. Plain text mirror lives in `descriptionText` for search.
  description     Json?
  descriptionText String? @map("description_text")

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(NONE)

  startDate DateTime? @map("start_date")
  dueDate   DateTime? @map("due_date")
  /// Decimal hours, so half-hour estimates are expressible.
  estimateHours Decimal? @map("estimate_hours") @db.Decimal(6, 2)

  /// Fractional index within (project, section).
  rank String

  createdById String  @map("created_by_id") @db.Uuid
  createdBy   Profile @relation("TaskCreator", fields: [createdById], references: [id])

  completedAt DateTime? @map("completed_at")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Maintained by a trigger, not the app — see the migration. Declared
  /// Unsupported so Prisma leaves it alone instead of trying to drop it.
  searchVector Unsupported("tsvector")? @map("search_vector")

  assignees  TaskAssignee[]
  labels     TaskLabel[]
  checklist  ChecklistItem[]

  @@unique([projectId, number])
  // The List and Board views always read "one project, ordered by rank".
  @@index([projectId, rank])
  @@index([projectId, status])
  @@index([dueDate])
  @@index([parentTaskId])
  @@index([sectionId])
  @@map("tasks")
}

/// Multiple assignees per task, so this is a join table rather than a column.
model TaskAssignee {
  id String @id @default(uuid()) @db.Uuid

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  profileId String  @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([taskId, profileId])
  // Powers "My tasks" across every project.
  @@index([profileId])
  @@map("task_assignees")
}

model Label {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String
  /// Design-system token name, not a raw colour.
  color String @default("neutral")

  createdAt DateTime @default(now()) @map("created_at")

  tasks TaskLabel[]

  @@unique([workspaceId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String @map("label_id") @db.Uuid
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

/// Lightweight steps inside a task — deliberately not full subtasks, which
/// carry assignees, dates and their own subtree.
model ChecklistItem {
  id String @id @default(uuid()) @db.Uuid

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title  String
  isDone Boolean @default(false) @map("is_done")
  rank   String

  @@index([taskId, rank])
  @@map("checklist_items")
}
