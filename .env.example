# ---------------------------------------------------------------------------
# Template. Copy to `.env.local` and fill in. Never put real values here —
# this file IS committed.
# ---------------------------------------------------------------------------

# Supabase provisioning credential (account-level, unscoped).
# Create one at https://supabase.com/dashboard/account/tokens
# Used only by the Supabase CLI for provisioning/migrations — never by app code.
SUPABASE_ACCESS_TOKEN=

# Project ref — the subdomain of your project URL.
SUPABASE_PROJECT_REF=

# Everything below is filled in by: npm run provision:env -- --db-password '<pw>'

# Pooled connection (pgbouncer, port 6543) — app runtime.
DATABASE_URL=
# Direct connection (port 5432) — `prisma migrate` only.
DIRECT_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Any long random string; must match the value configured in Vercel.
CRON_SECRET=
